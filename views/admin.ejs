<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
   <h1>Submitted orders</h1>
   <% if (orders.length === 0) { %>
      <p>No orders submitted yet.</p>
   <% } else { %>
    <table>
        <tr>
            <th>School</th>
            <th>County</th>
            <th>Village</th>
            <th>Email</th>
        </tr>
        <% orders.forEach(order => { %>
            <tr>
                <td><%= order.school %></td>
                <td><%= order.county %></td>
                <td><%= order.village %></td>
                <td><%= order.email %></td>
            </tr>
        <% }); %>
    </table>
      <!-- <ul>
         <% orders.forEach(order => { %>
            <li>
               <strong><%= order.school %></strong> from <%= order.village %>, <%= order.county %> - <%= order.email %>
               <p><%= order.message %></p>
            </li>
         <% }); %>
      </ul> -->
   <% } %>
</body>
</html>