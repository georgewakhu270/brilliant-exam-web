        </div>
        <div class="form-group textarea-group">
            <label for="order-msg"><span class="red">*</span>Write your order message</label>
            <textarea name="order-msg" id="order-msg" rows="4"></textarea>
        </div>
        <div>
            <input type="submit" value="Submit">
        </div>
    </form>
</div>
